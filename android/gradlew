#!/usr/bin/env sh
##############################################################################
##
##  gradlew startup script for Gradle
##
##############################################################################

# Attempt to set APP_HOME to the directory of this script, platform independent
case "${0}" in
  -*) ;;
  /*) ;;
  *) case "${0}" in
     */*) ;;
     *) SCRIPT_FILENAME="${BASH_SOURCE[0]}"
        if ([ -n "${ZSH_VERSION}" ]) then
          SCRIPT_FILENAME="/${SCRIPT_FILENAME}"
        else
          SCRIPT_FILENAME="${SCRIPT_FILENAME}"
        fi
        ;;
     esac
     SCRIPT_FILENAME="$(cd "$(dirname "${SCRIPT_FILENAME}")" && pwd)/$(basename "${SCRIPT_FILENAME}")"
     ;;
esac

APP_HOME="${SCRIPT_FILENAME%/*}"

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS='-Xmx1g'

# Use the project's gradle-wrapper.jar
WRAPPER_JAR="${APP_HOME}/gradle/wrapper/gradle-wrapper.jar"
WRAPPER_PROPERTIES="${APP_HOME}/gradle/wrapper/gradle-wrapper.properties"

# Load the properties from gradle-wrapper.properties
if [ -f "${WRAPPER_PROPERTIES}" ]; then
  . "${WRAPPER_PROPERTIES}"
fi

# Execute Gradle using the wrapper jar
exec java ${DEFAULT_JVM_OPTS} ${GRADLE_OPTS} -jar "${WRAPPER_JAR}" ${CMD_LINE_ARGS}
